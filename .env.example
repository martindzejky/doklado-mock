# Optional runtime settings for doklado-mock.
#
# Copy this file to `.env` for local development:
#
#   cp .env.example .env
#
# The mock needs no Doklado credentials and never talks to the real API.
# Organisations, series, and accepted api_key values live in the JSON config
# (doklado-mock.config.json, or DOKLADO_MOCK_CONFIG / --config).

# HOST=127.0.0.1
# PORT=3000
# DOKLADO_MOCK_CONFIG=./doklado-mock.config.json
