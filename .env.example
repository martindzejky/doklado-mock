# Environment variables
#
# Copy this file to `.env` for local development:
#
#   cp .env.example .env
#
# The mock server itself needs no credentials — it is a fake Doklado and never
# talks to the real one. These keys exist only for the capture scripts, which
# record real API responses so the mock's behaviour can be checked against
# reality. Doklado has no sandbox, so those scripts hit production and are
# read-only by default.

# API key from the Doklado web UI.
DOKLADO_API_KEY=replace-me

# Your company's IČO. Every Doklado endpoint is scoped to this.
DOKLADO_ORGANIZATION_ID=12345678

# Real Doklado API gateway. Point an app at the mock by overriding this.
DOKLADO_API_URL=https://api-gateway-prod-europe-west-1-7epuecvu.ew.gateway.dev
